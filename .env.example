# bb-lab environment — copy to .env and fill in. NEVER commit .env to git.

# ── Notifications ──────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=          # @BotFather token
TELEGRAM_CHAT_ID=            # your private chat id (@userinfobot)

# ── Tier A: frontier APIs (LiteLLM passthrough) ───────────────
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
XAI_API_KEY=
DEEPSEEK_API_KEY=

# ── LiteLLM router ────────────────────────────────────────────
LITELLM_BASE=http://127.0.0.1:4000
LITELLM_MASTER_KEY=sk-bb-local-change-me

# ── DefectDojo ────────────────────────────────────────────────
DOJO_URL=http://127.0.0.1:8080
DOJO_API_TOKEN=              # Dojo → Profile → API v2 token

# ── reNgine ───────────────────────────────────────────────────
RENGINE_URL=https://127.0.0.1       # its installer serves TLS on 443
RENGINE_USER=                       # basic-auth/API user
RENGINE_PASS=

# ── Agent layer ───────────────────────────────────────────────
STRIX_LLM=openai/tier-b              # litellm route name Strix uses
# Shannon reads ANTHROPIC_API_KEY etc. directly, or its own config

# ── Recon API keys (reNgine settings UI — optional boosts) ────
CHAOS_KEY=                           # projectdiscovery chaos
GITHUB_TOKEN=                        # org/repo enum + git-watch
SHODAN_API_KEY=
VIRUSTOTAL_API_KEY=
CENSYS_API_ID=
CENSYS_API_SECRET=

# ── Tuning ────────────────────────────────────────────────────
BB_RATE_LIMIT=150                    # req/s ceiling for scans
BB_MAX_PARALLEL_TARGETS=4
BB_LLM_DAILY_BUDGET_USD=10           # litellm budget cap
NUCLEI_TEMPLATES_DIR=~/bb-lab/run/nuclei-templates
